<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pidog_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 hardware driver for SunFounder PiDog (cmd_vel, actions, joint commands, IMU)</description>
  <maintainer email="pidog@example.com">pidog</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
